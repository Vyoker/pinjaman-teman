# === WAJIB: akun admin (pemberi pinjaman) ===
# Nomor HP admin untuk login (bebas, mis. 081234567890)
ADMIN_PHONE=081234567890
# Password admin — JANGAN pakai password yang dipakai di tempat lain
ADMIN_PASSWORD=ganti-dengan-password-kuat

# === Otomatis terisi saat Vercel KV dihubungkan ke project ===
# (dibuat di dashboard Vercel: Storage > Create Database > KV)
KV_REST_API_URL=
KV_REST_API_TOKEN=
